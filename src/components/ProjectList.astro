---
import { projects } from '../data/projects.ts';
import ExternalLink from './ExternalLink.astro';
---

<div class="projects-wrap">
  <span class="row-highlight" aria-hidden="true"></span>
  <span class="cursor-glyph" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="20" height="20">
      <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
    </svg>
  </span>
  <ul class="projects">
    {
      projects.map((project) => {
        const expandable = Boolean(project.details || project.url);
        const images = Array.isArray(project.image)
          ? project.image
          : project.image
            ? [project.image]
            : [];

        const summary = (
          <div class="project-summary">
            <span class="project-title">{project.title}</span>
            <span class="project-description">{project.description}</span>
            {expandable && (
              <span class="marker" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="12" height="12">
                  <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
              </span>
            )}
          </div>
        );

        if (!expandable) {
          return (
            <li class="project">
              {summary}
            </li>
          );
        }

        return (
          <li>
            <details class="project" name="projects" open={project.open}>
              <summary>{summary}</summary>
              <div class="project-details">
                {images.length > 0 && (
                  <div
                    class="project-gallery"
                    data-cycle={images.length > 1 ? 'true' : undefined}
                  >
                    <div class="project-gallery__images">
                      {images.map((src, i) => (
                        <img
                          class:list={['project-image', { 'is-active': i === 0 }]}
                          src={src}
                          alt={i === 0 ? (project.imageAlt ?? '') : ''}
                          width={2162}
                          height={1390}
                          loading={i === 0 ? 'eager' : 'lazy'}
                          fetchpriority="low"
                          decoding="async"
                        />
                      ))}
                    </div>
                    {images.length > 1 && (
                      <div class="gallery-progress" aria-hidden="true">
                        {images.map(() => (
                          <span class="gallery-progress__seg"></span>
                        ))}
                      </div>
                    )}
                  </div>
                )}
                {project.details && <p>{project.details}</p>}
                {(project.year || project.url) && (
                  <p class="project-meta">
                    {project.year && <span class="project-year">{project.year}</span>}
                    {project.year && project.url && (
                      <span class="dot" aria-hidden="true">·</span>
                    )}
                    {project.url && (
                      <ExternalLink href={project.url}>
                        {project.urlLabel ?? 'Visit'}
                      </ExternalLink>
                    )}
                  </p>
                )}
              </div>
            </details>
          </li>
        );
      })
    }
  </ul>
</div>

<script>
  const wrap = document.querySelector<HTMLElement>('.projects-wrap');
  const highlight = wrap?.querySelector<HTMLElement>('.row-highlight');
  const cursor = wrap?.querySelector<HTMLElement>('.cursor-glyph');

  if (wrap && highlight && cursor && window.matchMedia('(hover: hover)').matches) {
    // Re-parent to <body> so ancestor transforms don't break position: fixed.
    if (cursor.parentElement !== document.body) {
      document.body.appendChild(cursor);
    }

    let activeRow: HTMLElement | null = null;
    let pendingHighlightFrame = 0;
    let pendingCursorFrame = 0;
    let mouseX = 0;
    let mouseY = 0;

    const moveTo = (row: HTMLElement) => {
      const r = row.getBoundingClientRect();
      const w = wrap.getBoundingClientRect();
      highlight.style.transform = `translate(${r.left - w.left}px, ${r.top - w.top}px)`;
      highlight.style.width = `${r.width}px`;
      highlight.style.height = `${r.height}px`;
      highlight.dataset.visible = 'true';
    };

    const hideHighlight = () => {
      activeRow = null;
      delete highlight.dataset.visible;
    };

    const updateCursorPosition = () => {
      cursor.style.transform = `translate3d(${mouseX - 10}px, ${mouseY - 10}px, 0)`;
    };

    const setCursorOver = (summary: HTMLElement | null) => {
      if (!summary) {
        delete cursor.dataset.active;
        return;
      }
      cursor.dataset.active = 'true';
      const parent = summary.parentElement;
      cursor.dataset.rotated =
        parent instanceof HTMLDetailsElement && parent.open ? 'true' : 'false';
    };

    const showCursor = (rotated: boolean) => {
      cursor.dataset.active = 'true';
      cursor.dataset.rotated = rotated ? 'true' : 'false';
    };

    const hideCursor = () => {
      delete cursor.dataset.active;
    };

    const handlePointer = (event: PointerEvent) => {
      mouseX = event.clientX;
      mouseY = event.clientY;
      cancelAnimationFrame(pendingCursorFrame);
      pendingCursorFrame = requestAnimationFrame(updateCursorPosition);

      const target = event.target as HTMLElement | null;
      const isInteractive = !!target?.closest('a, button, input, textarea');
      const summary = target?.closest<HTMLElement>('details.project > summary');
      const detailsContent = target?.closest<HTMLElement>('.project-details');
      const row = target?.closest<HTMLElement>('summary, li.project');

      if (isInteractive) {
        hideCursor();
        hideHighlight();
        return;
      }

      if (detailsContent) {
        showCursor(true);
        hideHighlight();
        return;
      }

      if (summary) {
        const parent = summary.parentElement;
        const isOpen =
          parent instanceof HTMLDetailsElement && parent.open;
        showCursor(isOpen);
        if (isOpen) {
          hideHighlight();
          return;
        }
      } else if (row) {
        hideCursor();
      } else {
        hideCursor();
        hideHighlight();
        return;
      }

      if (row && row !== activeRow) {
        activeRow = row;
        cancelAnimationFrame(pendingHighlightFrame);
        pendingHighlightFrame = requestAnimationFrame(() => moveTo(row));
      }
    };

    const handleLeave = () => {
      hideHighlight();
      hideCursor();
    };

    const handleToggle = () => {
      hideHighlight();
      const hoveredSummary = wrap.querySelector<HTMLElement>(
        'details.project > summary:hover',
      );
      const hoveredDetails = wrap.querySelector<HTMLElement>(
        'details.project[open] .project-details:hover',
      );
      if (hoveredDetails) {
        showCursor(true);
      } else if (hoveredSummary) {
        const parent = hoveredSummary.parentElement;
        const isOpen =
          parent instanceof HTMLDetailsElement && parent.open;
        showCursor(isOpen);
      } else {
        hideCursor();
      }
    };

    const handleClick = (event: MouseEvent) => {
      const target = event.target as HTMLElement | null;
      if (!target) return;
      const detailsContent = target.closest<HTMLElement>('.project-details');
      if (!detailsContent) return;

      if (target.closest('a, button, input, textarea, select, label')) return;

      const selection = window.getSelection();
      if (selection && selection.toString().length > 0) return;

      const parent = detailsContent.parentElement;
      if (parent instanceof HTMLDetailsElement) {
        parent.open = false;
      }
    };

    wrap.addEventListener('toggle', handleToggle, true);
    wrap.addEventListener('pointermove', handlePointer);
    wrap.addEventListener('pointerleave', handleLeave);
    wrap.addEventListener('click', handleClick);
    window.addEventListener('resize', () => {
      if (activeRow) moveTo(activeRow);
    });

    document.documentElement.classList.add('fake-cursor-active');
  }

  // Gallery crossfade: cycle stacked project images when a details opens.
  const galleryWrap = document.querySelector<HTMLElement>('.projects-wrap');
  if (galleryWrap) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let cycleTimer: number | null = null;

    const setProgressState = (segs: HTMLElement[], activeIdx: number) => {
      segs.forEach((seg, idx) => {
        seg.classList.remove('is-active', 'is-filled');
        if (idx < activeIdx) seg.classList.add('is-filled');
      });
      // Force reflow so the fill animation restarts cleanly on loop.
      segs[activeIdx]?.getBoundingClientRect();
      segs[activeIdx]?.classList.add('is-active');
    };

    galleryWrap.addEventListener(
      'toggle',
      (event) => {
        if (cycleTimer !== null) {
          window.clearInterval(cycleTimer);
          cycleTimer = null;
        }
        const target = event.target;
        if (!(target instanceof HTMLDetailsElement) || !target.open || reducedMotion) return;
        const gallery = target.querySelector<HTMLElement>(
          '.project-gallery[data-cycle="true"]',
        );
        if (!gallery) return;
        const imgs = [...gallery.querySelectorAll<HTMLImageElement>('.project-image')];
        if (imgs.length < 2) return;
        const segs = [
          ...gallery.querySelectorAll<HTMLElement>('.gallery-progress__seg'),
        ];
        let i = 0;
        setProgressState(segs, 0);
        cycleTimer = window.setInterval(() => {
          imgs[i].classList.remove('is-active');
          i = (i + 1) % imgs.length;
          imgs[i].classList.add('is-active');
          setProgressState(segs, i);
        }, 3000);
      },
      true,
    );
  }
</script>
