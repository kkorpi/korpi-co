---
import { projects } from '../data/projects.ts';
import ExternalLink from './ExternalLink.astro';

const VIDEO_EXTS = new Set(['mp4', 'webm', 'mov', 'm4v']);
const isVideoSrc = (src: string) => {
  const ext = src.split('?')[0].split('.').pop()?.toLowerCase() ?? '';
  return VIDEO_EXTS.has(ext);
};

type Slide = { src: string; replay?: boolean; isVideo: boolean };
const toSlide = (item: string | { src: string; replay?: boolean }): Slide => {
  const obj = typeof item === 'string' ? { src: item } : item;
  return { ...obj, isVideo: isVideoSrc(obj.src) };
};
---

<div class="projects-wrap">
  <span class="row-highlight" aria-hidden="true"></span>
  <span class="cursor-glyph" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="20" height="20">
      <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
    </svg>
  </span>
  <ul class="projects">
    {
      projects.map((project) => {
        const expandable = Boolean(project.details || project.url);
        const rawImages = Array.isArray(project.image)
          ? project.image
          : project.image
            ? [project.image]
            : [];
        const slides = rawImages.map(toSlide);

        const summary = (
          <div class="project-summary">
            <span class="project-title">{project.title}</span>
            <span class="project-description">{project.description}</span>
            {expandable && (
              <span class="marker" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="12" height="12">
                  <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
              </span>
            )}
          </div>
        );

        if (!expandable) {
          return (
            <li class="project">
              {summary}
            </li>
          );
        }

        return (
          <li>
            <details class="project" name="projects" open={project.open}>
              <summary>{summary}</summary>
              <div class="project-details">
                {slides.length > 0 && (
                  <div
                    class="project-gallery"
                    data-cycle={slides.length > 1 ? 'true' : undefined}
                  >
                    <div class="project-gallery__images">
                      {slides.map((slide, i) => (
                        slide.isVideo ? (
                          <video
                            class:list={['project-image', { 'is-active': i === 0 }]}
                            src={slide.src}
                            width={2162}
                            height={1390}
                            muted
                            loop
                            playsinline
                            preload="metadata"
                            aria-label={i === 0 ? (project.imageAlt ?? undefined) : undefined}
                          ></video>
                        ) : (
                          <img
                            class:list={['project-image', { 'is-active': i === 0 }]}
                            src={slide.src}
                            alt={i === 0 ? (project.imageAlt ?? '') : ''}
                            width={2162}
                            height={1390}
                            loading={i === 0 ? 'eager' : 'lazy'}
                            fetchpriority="low"
                            decoding="async"
                            data-replay={slide.replay ? 'true' : undefined}
                          />
                        )
                      ))}
                    </div>
                    {slides.length > 1 && (
                      <div class="gallery-progress" aria-hidden="true">
                        {slides.map(() => (
                          <span class="gallery-progress__seg"></span>
                        ))}
                      </div>
                    )}
                  </div>
                )}
                {project.details && <p>{project.details}</p>}
                {(project.year || project.url) && (
                  <p class="project-meta">
                    {project.year && <span class="project-year">{project.year}</span>}
                    {project.year && project.url && (
                      <span class="dot" aria-hidden="true">·</span>
                    )}
                    {project.url && (
                      <ExternalLink href={project.url}>
                        {project.urlLabel ?? 'Visit'}
                      </ExternalLink>
                    )}
                  </p>
                )}
              </div>
            </details>
          </li>
        );
      })
    }
  </ul>
</div>

<script>
  const wrap = document.querySelector<HTMLElement>('.projects-wrap');
  const highlight = wrap?.querySelector<HTMLElement>('.row-highlight');
  const cursor = wrap?.querySelector<HTMLElement>('.cursor-glyph');

  if (wrap && highlight && cursor && window.matchMedia('(hover: hover)').matches) {
    // Re-parent to <body> so ancestor transforms don't break position: fixed.
    if (cursor.parentElement !== document.body) {
      document.body.appendChild(cursor);
    }

    let activeRow: HTMLElement | null = null;
    let pendingHighlightFrame = 0;
    let pendingCursorFrame = 0;
    let mouseX = 0;
    let mouseY = 0;

    const moveTo = (row: HTMLElement) => {
      const r = row.getBoundingClientRect();
      const w = wrap.getBoundingClientRect();
      highlight.style.transform = `translate(${r.left - w.left}px, ${r.top - w.top}px)`;
      highlight.style.width = `${r.width}px`;
      highlight.style.height = `${r.height}px`;
      highlight.dataset.visible = 'true';
    };

    const hideHighlight = () => {
      activeRow = null;
      delete highlight.dataset.visible;
    };

    const updateCursorPosition = () => {
      cursor.style.transform = `translate3d(${mouseX - 10}px, ${mouseY - 10}px, 0)`;
    };

    const setCursorOver = (summary: HTMLElement | null) => {
      if (!summary) {
        delete cursor.dataset.active;
        return;
      }
      cursor.dataset.active = 'true';
      const parent = summary.parentElement;
      cursor.dataset.rotated =
        parent instanceof HTMLDetailsElement && parent.open ? 'true' : 'false';
    };

    const showCursor = (rotated: boolean) => {
      cursor.dataset.active = 'true';
      cursor.dataset.rotated = rotated ? 'true' : 'false';
    };

    const hideCursor = () => {
      delete cursor.dataset.active;
    };

    const handlePointer = (event: PointerEvent) => {
      mouseX = event.clientX;
      mouseY = event.clientY;
      cancelAnimationFrame(pendingCursorFrame);
      pendingCursorFrame = requestAnimationFrame(updateCursorPosition);

      const target = event.target as HTMLElement | null;
      const isInteractive = !!target?.closest('a, button, input, textarea');
      const summary = target?.closest<HTMLElement>('details.project > summary');
      const detailsContent = target?.closest<HTMLElement>('.project-details');
      const row = target?.closest<HTMLElement>('summary, li.project');

      if (isInteractive) {
        hideCursor();
        hideHighlight();
        return;
      }

      if (detailsContent) {
        showCursor(true);
        hideHighlight();
        return;
      }

      if (summary) {
        const parent = summary.parentElement;
        const isOpen =
          parent instanceof HTMLDetailsElement && parent.open;
        showCursor(isOpen);
        if (isOpen) {
          hideHighlight();
          return;
        }
      } else if (row) {
        hideCursor();
      } else {
        hideCursor();
        hideHighlight();
        return;
      }

      if (row && row !== activeRow) {
        activeRow = row;
        cancelAnimationFrame(pendingHighlightFrame);
        pendingHighlightFrame = requestAnimationFrame(() => moveTo(row));
      }
    };

    const handleLeave = () => {
      hideHighlight();
      hideCursor();
    };

    const handleToggle = () => {
      hideHighlight();
      const hoveredSummary = wrap.querySelector<HTMLElement>(
        'details.project > summary:hover',
      );
      const hoveredDetails = wrap.querySelector<HTMLElement>(
        'details.project[open] .project-details:hover',
      );
      if (hoveredDetails) {
        showCursor(true);
      } else if (hoveredSummary) {
        const parent = hoveredSummary.parentElement;
        const isOpen =
          parent instanceof HTMLDetailsElement && parent.open;
        showCursor(isOpen);
      } else {
        hideCursor();
      }
    };

    const handleClick = (event: MouseEvent) => {
      const target = event.target as HTMLElement | null;
      if (!target) return;
      const detailsContent = target.closest<HTMLElement>('.project-details');
      if (!detailsContent) return;

      if (target.closest('a, button, input, textarea, select, label')) return;

      const selection = window.getSelection();
      if (selection && selection.toString().length > 0) return;

      const parent = detailsContent.parentElement;
      if (parent instanceof HTMLDetailsElement) {
        parent.open = false;
      }
    };

    wrap.addEventListener('toggle', handleToggle, true);
    wrap.addEventListener('pointermove', handlePointer);
    wrap.addEventListener('pointerleave', handleLeave);
    wrap.addEventListener('click', handleClick);
    window.addEventListener('resize', () => {
      if (activeRow) moveTo(activeRow);
    });

    document.documentElement.classList.add('fake-cursor-active');
  }

  // Gallery crossfade: cycle stacked project images while a details is open.
  const galleryWrap = document.querySelector<HTMLElement>('.projects-wrap');
  if (galleryWrap) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let cycleTimer: number | null = null;
    let restartScheduled = false;

    const setProgressState = (segs: HTMLElement[], activeIdx: number) => {
      segs.forEach((seg, idx) => {
        seg.classList.remove('is-active', 'is-filled');
        if (idx < activeIdx) seg.classList.add('is-filled');
      });
      // Force reflow so the fill animation restarts cleanly on loop.
      segs[activeIdx]?.getBoundingClientRect();
      segs[activeIdx]?.classList.add('is-active');
    };

    // Pause every video in the gallery wrap — used when a details closes.
    const pauseAllVideos = () => {
      galleryWrap
        .querySelectorAll<HTMLVideoElement>('video.project-image')
        .forEach((v) => v.pause());
    };

    // Restart an animated image (WebP/GIF with loop=1) by re-assigning src
    // with a cache-busting fragment. Bytes stay cached; URL change forces
    // the decoder to reset and replay from frame 1.
    const restartReplayable = (img: HTMLImageElement) => {
      const base = img.src.split('#')[0];
      img.src = `${base}#${Date.now()}`;
    };

    // Activate slide `idx`: toggle is-active, play active video / pause
    // others, restart replay-flagged images.
    const activateSlide = (slides: HTMLElement[], idx: number) => {
      slides.forEach((slide, n) => {
        const active = n === idx;
        slide.classList.toggle('is-active', active);
        if (slide instanceof HTMLVideoElement) {
          if (active) {
            void slide.play().catch(() => {});
          } else {
            slide.pause();
          }
        } else if (
          active &&
          slide instanceof HTMLImageElement &&
          slide.dataset.replay === 'true'
        ) {
          restartReplayable(slide);
        }
      });
    };

    // State for the currently-cycling gallery — exposed so the click
    // handler can advance and restart the timer from outside restartCycle.
    let cycleState: {
      slides: HTMLElement[];
      segs: HTMLElement[];
      i: number;
    } | null = null;

    const tick = () => {
      if (!cycleState) return;
      cycleState.i = (cycleState.i + 1) % cycleState.slides.length;
      activateSlide(cycleState.slides, cycleState.i);
      setProgressState(cycleState.segs, cycleState.i);
    };

    const startTimer = () => {
      if (cycleTimer !== null) window.clearInterval(cycleTimer);
      cycleTimer = window.setInterval(tick, 3000);
    };

    const restartCycle = () => {
      if (cycleTimer !== null) {
        window.clearInterval(cycleTimer);
        cycleTimer = null;
      }
      cycleState = null;

      // Whichever details just opened or closed — pause every video first.
      // The active one in the open gallery will get its play() call below.
      pauseAllVideos();

      if (reducedMotion) return;

      // Use the actually-open details in the DOM, not event.target — the
      // accordion fires both close + open events and target.open of the
      // close event would short-circuit the handler.
      const openDetails = galleryWrap.querySelector<HTMLDetailsElement>(
        'details.project[open]',
      );
      if (!openDetails) return;
      const gallery = openDetails.querySelector<HTMLElement>(
        '.project-gallery[data-cycle="true"]',
      );
      if (!gallery) {
        // Single-slide gallery: still kick off the active slide (so a lone
        // video plays when the details opens).
        const singleGallery = openDetails.querySelector<HTMLElement>(
          '.project-gallery',
        );
        if (singleGallery) {
          const slides = [
            ...singleGallery.querySelectorAll<HTMLElement>('.project-image'),
          ];
          activateSlide(slides, 0);
        }
        return;
      }
      const slides = [
        ...gallery.querySelectorAll<HTMLElement>('.project-image'),
      ];
      if (slides.length < 2) return;
      const segs = [
        ...gallery.querySelectorAll<HTMLElement>('.gallery-progress__seg'),
      ];

      // Reset to first slide in case this gallery was previously left mid-cycle.
      cycleState = { slides, segs, i: 0 };
      activateSlide(slides, 0);
      setProgressState(segs, 0);
      startTimer();
    };

    // Click anywhere inside the cycling gallery's image stack → advance.
    // Restart the timer so the user gets a full slot on the manually advanced
    // slide before the auto-cycle ticks again. Ignore clicks on links inside.
    galleryWrap.addEventListener('click', (e) => {
      if (!cycleState) return;
      const target = e.target as HTMLElement | null;
      if (!target) return;
      if (target.closest('a, button, input, textarea, select')) return;
      if (!target.closest('.project-gallery__images')) return;
      tick();
      startTimer();
    });

    // Coalesce the close+open toggle pair into a single restart per frame so we
    // don't restart the cycle twice (which causes a visible blip).
    const scheduleRestart = () => {
      if (restartScheduled) return;
      restartScheduled = true;
      requestAnimationFrame(() => {
        restartScheduled = false;
        restartCycle();
      });
    };

    galleryWrap.addEventListener('toggle', scheduleRestart, true);
  }
</script>
