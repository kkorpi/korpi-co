---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import ExternalLink from '../components/ExternalLink.astro';
import ProjectList from '../components/ProjectList.astro';
import Footer from '../components/Footer.astro';
import CopyEmail from '../components/CopyEmail.astro';

// Drop more images in src/assets/ and add them here. They'll auto-cycle.
import kwk from '../assets/kwk.jpg';
import kwk2 from '../assets/kwk2.jpg';
import kwk3 from '../assets/kwk3.jpg';
import kwk4 from '../assets/kwk4.jpg';
import kwk5 from '../assets/kwk5.jpg';
import kwk6 from '../assets/kwk6.jpg';

const heroImages = [kwk,kwk2,kwk3,kwk4,kwk6];
---

<Base>
  <header>
    <h1 data-scramble>Kevin Korpi</h1>
    <p class="tagline" data-scramble>Product Designer + Photographer</p>
    <div class="hero-gallery">
      {
        heroImages.map((img, i) => (
          <Image
            src={img}
            alt={i === 0 ? 'Kevin Korpi Product Designer + Photographer' : ''}
            class:list={['hero-image', { 'is-active': i === 0 }]}
            loading="eager"
            fetchpriority={i === 0 ? 'high' : 'low'}
          />
        ))
      }
    </div>
  </header>

  <section aria-label="About" class="about">
    <p>I've been designing 0→1 products for 25+ years. Software, hardware, cameras, creator tools, AI. After bumming around as an English editor with my Pentax K1000 film camera and snowboard in Hokkaido, I got my start in Tokyo writing copy at a tiny Japanese studio, then slid into design and never really left, through a Tokyo agency running a bilingual design team, in-house at the usual big tech suspects, and startups since.</p>
    <p>Seattle → Tokyo → Hokkaido → Tokyo → Seattle → Bend, Oregon. I was raised on skateboarding, snowboarding, and punk rock, and never outgrew any of it. Usually have a camera on me.
    </p>
<p>I work with founders on early-stage products through <ExternalLink href="https://holdfast.studio">Hold Fast Studio</ExternalLink>. Mostly 0-to-1 work in hardware, software, and AI, where the org doesn't have a playbook yet. Taking on new clients starting mid-July.</p>
  </section>

  <section aria-labelledby="contact-heading" class="elsewhere">
    <h2 id="contact-heading">Elsewhere</h2>
    <ul class="contact">
      <li><ExternalLink href="https://www.linkedin.com/in/kevkor">LinkedIn</ExternalLink></li>
      <li><ExternalLink href="https://instagram.com/kevkor">Instagram</ExternalLink></li>
      <li><ExternalLink href="https://kevkor.substack.com">Writing</ExternalLink></li>
     <li><CopyEmail email="kevin@korpi.co" /></li>
    </ul>
  </section>

  <section aria-labelledby="projects-heading">
    <h2 id="projects-heading">Highlights</h2>
    <ProjectList />
  </section>

  <Footer />
</Base>

<script>
  // Hero gallery cross-fade cycle
  const gallery = document.querySelector<HTMLElement>('.hero-gallery');
  if (gallery) {
    const imgs = [...gallery.querySelectorAll<HTMLImageElement>('.hero-image')];

    // CSS transition needs an initial state to fade from, gate `is-active` opacity on `loaded`.
    imgs.forEach((img) => {
      if (img.complete && img.naturalWidth > 0) {
        img.classList.add('loaded');
      } else {
        img.addEventListener('load', () => img.classList.add('loaded'), { once: true });
      }
    });

    if (imgs.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let i = 0;
      setInterval(() => {
        imgs[i].classList.remove('is-active');
        i = (i + 1) % imgs.length;
        imgs[i].classList.add('is-active');
      }, 3000);
    }
  }

</script>
